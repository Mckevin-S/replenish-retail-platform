{
  "name": "pr-guard",
  "version": "0.1.0",
  "description": "Action GitHub qui commente les pull requests de replenish-retail-platform",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run --coverage.enabled=false",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js"
  },
  "license": "ISC",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module"
}